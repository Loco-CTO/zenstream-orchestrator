{
  "name": "zenstream-orchestrator-launcher",
  "version": "1.0.5",
  "private": true,
  "description": "Windows launcher for ZenStream Orchestrator",
  "author": "Rystal Team",
  "license": "GPL-3.0-only",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.electron.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "lint": "npm run typecheck && prettier --check .",
    "lint:fix": "prettier --write .",
    "pack:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/pack-windows.ps1"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.44.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "prettier": "^3.9.0",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "vitest": "^4.0.0",
    "wait-on": "^9.0.0"
  },
  "build": {
    "appId": "net.rystal.zenstream.orchestrator",
    "productName": "ZenStream Orchestrator",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist/backend",
        "to": "backend"
      },
      {
        "from": "../assets/icons/icon.png",
        "to": "assets/icon.png"
      }
    ],
    "win": {
      "icon": "../assets/icons/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "forceCodeSigning": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "ZenStream-Orchestrator-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "ZenStream-Orchestrator-Portable-${version}-${arch}.${ext}",
      "requestExecutionLevel": "user"
    }
  }
}
