SECRET_KEY=replace-with-a-random-secret
ORCHESTRATOR_HOST=127.0.0.1
ORCHESTRATOR_PORT=9088
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
TRUSTED_PROXY_IPS=
ZENSTREAM_LOG_LEVEL=INFO
# Existing host directory containing your media. Docker mounts it at /media.
LIBRARY_PATH=./library
# Persistent host directory for SQLite, rotating logs, and generated caches.
METADATA_PATH=./metadata
# Bounded metadata scan and asset worker settings.
METADATA_ROOT_WORKERS=4
METADATA_FETCH_WORKERS=12
METADATA_ASSET_WORKERS=4
FOREGROUND_WORKERS=16
METADATA_PROVIDER_TIMEOUT_SECONDS=20
METADATA_IMAGE_TIMEOUT_SECONDS=20
METADATA_IMAGE_HOST_ALLOWLIST=image.tmdb.org,media.themoviedb.org,artworks.thetvdb.com
FFMPEG_PATH=
FFPROBE_PATH=
MAX_TRANSCODES=0
MAX_TRANSCODES_PER_USER=0
PLAYBACK_SESSION_IDLE_TIMEOUT_SECONDS=45
